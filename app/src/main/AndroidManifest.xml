<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Sole permission added by feature 002 (FR-013/FR-004, research.md R-01,
      Constitution VIII): the Applications figure requires the TOTAL installed-app
      count, and since API 30 no <queries> subset can enumerate all packages —
      only QUERY_ALL_PACKAGES can. Install-time normal permission; the app's
      F-Droid distribution target makes Play's restriction of this permission N/A.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      The two remove directives below strip the app-defined
      DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION that androidx.core injects through
      manifest merging — this app registers no receivers, so that permission
      must stay out of the merged surface (feature 001, Constitution VIII).
    -->
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AndroidAnalyzer">

        <!-- Sole declared component: exported launcher Activity (US1). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
