<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Zero <uses-permission> elements (FR-009): the skeleton requests nothing.
      The two remove directives below strip the app-defined
      DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION that androidx.core injects through
      manifest merging — this app registers no receivers, so the permission
      surface must stay completely empty (U-4, data-model S-2, Constitution VIII).
    -->
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AndroidAnalyzer">

        <!-- Sole declared component: exported launcher Activity (US1). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
